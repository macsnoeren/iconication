[app]
# URL van de PHP webapplicatie (zonder trailing slash)
php_app_url = http://localhost/iconication/public/index.php

# API key — kopieer deze uit het Admin-paneel van de webapplicatie
api_key =

# Poll-interval in seconden
poll_interval = 10

[ai]
# URL van de lokale Ollama instantie
ollama_url = http://localhost:11434/api/generate

# Ollama model om te gebruiken (bijv. llama3, mistral, phi3, gemma2)
ollama_model = llama3

# Taal voor ARASAAC pictogrammen zoeken (nl, en, fr, de, es, ...)
arasaac_language = nl

# Naam van het getuunde model (aangemaakt via python worker.py --tune)
# Leeglaten om altijd het basis model te gebruiken
tuned_model_name = iconication-aac

# Pad naar de ollama binary (standaard: ollama)
# ollama_bin = ollama
