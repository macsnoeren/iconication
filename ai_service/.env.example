# URL van de PHP webapplicatie (zonder trailing slash)
PHP_APP_URL=http://localhost/iconication/public/index.php

# API key — kopieer deze uit het Admin-paneel van de webapplicatie
ICONICATION_API_KEY=

# Poll-interval in seconden (standaard: 10)
# POLL_INTERVAL=10

# Kies je AI-provider: "anthropic" (standaard) of "openai"
AI_PROVIDER=anthropic

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI — https://platform.openai.com/
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
